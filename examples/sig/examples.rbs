# helpers_for_inline_associations.rb
module HelpersForInlineAssociationsExample
  class Book
    attr_reader id: untyped
    attr_reader title: untyped

    def initialize: (untyped id, untyped title) -> void
  end

  class Library
    attr_reader id: untyped
    attr_reader name: untyped
    attr_reader books: untyped

    def initialize: (untyped id, untyped name, untyped books) -> void
  end

  class ApplicationResource
    include ResourceInstanceMethods
    extend ResourceClassMethods

    def with_id: () -> untyped
    def with_title: () -> untyped
    def self.with_id: () -> untyped
    def self.with_title: () -> untyped
  end

  class LibraryResource < ApplicationResource
  end
end

# inline_definition.rb
module InlineDefinitionExample
  class Article
    attr_reader title: untyped
    attr_reader body: untyped

    def initialize: (untyped title, untyped body) -> void
  end

  class User
    attr_reader id: untyped
    attr_reader articles: untyped

    def initialize: (untyped id, untyped articles) -> void
  end
end

# key_transformation.rb
module KeyTransformationExample
  module ExampleInflector
    def self?.camelize: (untyped str) -> untyped

    def self?.camelize_lower: (untyped str) -> untyped

    def self?.dasherize: (untyped str) -> untyped

    def self?.classify: (untyped str) -> untyped

    def self?.demodulize: (untyped str) -> untyped

    def self?.underscore: (untyped str) -> untyped

    def self?.pluralize: (untyped str) -> String
  end

  class User
    attr_reader id: untyped
    attr_reader first_name: untyped
    attr_reader last_name: untyped

    def initialize: (untyped id, untyped first_name, untyped last_name) -> void
  end

  class UserResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end
end

