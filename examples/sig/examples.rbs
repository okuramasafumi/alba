# metadata_and_pagination.rb
module MetadataAndPaginationExample
  class User
    attr_reader id: untyped
    attr_reader name: untyped

    def initialize: (untyped id, untyped name) -> void
  end

  class PaginatedUsers
    attr_reader items: untyped
    attr_reader page: untyped
    attr_reader per_page: untyped
    attr_reader total: untyped

    def initialize: (untyped items, page: untyped, per_page: untyped, total: untyped) -> void
    def total_pages: () -> untyped
  end

  class UserResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end

  class PaginatedUsersResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end
end

# method_conflicts.rb
module MethodConflictsExample
  class Report
    attr_reader format: untyped

    def initialize: (untyped format) -> void
  end

  class ResourceMethodFirstReportResource
    include ResourceInstanceMethods
    extend ResourceClassMethods

    def format: (untyped report) -> String
  end

  class ObjectMethodFirstReportResource
    include ResourceInstanceMethods
    extend ResourceClassMethods

    def format: (untyped report) -> String
  end
end

