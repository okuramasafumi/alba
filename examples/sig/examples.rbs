    def initialize: (untyped id, untyped name) -> void
  end

  class UserResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end
end

# conditional_attributes_and_associations.rb
module ConditionalAttributesAndAssociationsExample
  class Post
    attr_reader title: untyped

    def initialize: (untyped title) -> void
  end

  class User
    attr_reader id: untyped
    attr_reader name: untyped
    attr_reader email: untyped
    attr_reader posts: untyped

    def initialize: (untyped id, untyped name, untyped email, ?untyped posts) -> void
  end

  class UserResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end
end

# custom_association_source.rb
module CustomAssociationSourceExample
  class Article
    attr_reader title: untyped
    attr_reader status: untyped

    def initialize: (untyped title, untyped status) -> void
  end

  class User
    @metadata: untyped

    attr_reader id: untyped
    attr_reader name: untyped
    attr_reader articles: untyped

    def initialize: (untyped id, untyped name, untyped articles) -> void
    def custom_profile: () -> Hash[Symbol, String]
    def articles_by_status: (untyped status) -> untyped
  end

  class MetadataResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end

  class ArticleResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end

  class UserResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end
end

