use Alba::Resource::InstanceMethods as ResourceInstanceMethods
use Alba::Resource::ClassMethods as ResourceClassMethods

# circular_associations_control.rb
module CircularAssociationsControlExample
  class Author
    attr_accessor name: untyped
    attr_accessor books: untyped

    def initialize: (untyped name, ?untyped books) -> void
  end

  class Book
    attr_accessor title: untyped
    attr_accessor authors: untyped

    def initialize: (untyped title, ?untyped authors) -> void
  end

  class AuthorResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end

  class BookResource
    include ResourceInstanceMethods
    extend ResourceClassMethods
  end
end

