module Alba
  # Representing typed attributes to encapsulate logic about types
  class TypedAttribute
    attr_reader name: Symbol | String
    
    @name: Symbol | String
    @type: Alba::Type
    @block: untyped
    
    def initialize: (
      name: Symbol | String,
      type: Symbol | Class,
      converter: untyped
    ) ?{ (untyped) -> untyped } -> void
    
    def value: (?object: untyped) { (Symbol | String) -> untyped } -> untyped
    
    private
    
    def display_value_for: (untyped value) -> String
  end
end
