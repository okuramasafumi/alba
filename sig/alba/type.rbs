module Alba
  # Representing type itself, combined with TypedAttribute
  class Type
    attr_reader name: Symbol | String | Class
    attr_writer auto_convert: bool
    
    @name: Symbol | String | Class
    @check: untyped
    @converter: untyped
    @auto_convert: bool
    
    def initialize: (
      Symbol | String | Class name,
      check: Proc | false,
      converter: untyped,
      ?auto_convert: bool
    ) -> void
    
    def check: (untyped value) -> bool
    def convert: (untyped obj) -> untyped
    def auto_convert_with: (Proc converter) -> void
  end
end
