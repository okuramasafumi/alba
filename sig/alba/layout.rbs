module Alba
  # Layout serialization
  class Layout
    @body: untyped
    @resource: untyped
    @serialized_json: String

    def object: () -> untyped
    def params: () -> generic_hash
    def serializable_hash: () -> generic_hash
    def to_h: () -> generic_hash

    def self.def_delegators: (Symbol, *Symbol) -> void

    def initialize: (
      file: String?,
      inline: Proc?
    ) -> void

    def serialize: (
      resource: Alba::Resource::_InstanceMethods,
      serialized_json: String,
      binding: Binding
    ) -> String

    private

    attr_reader serialized_json: String

    def check_and_return: (Object obj, String message, Class klass) -> Object
    def serialize_within_string_layout: (Binding bnd) -> String
    def serialize_within_inline_layout: () -> String
    def encode: (generic_hash hash) -> String
  end
end
