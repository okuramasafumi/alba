module Alba
  module Resource
    type attribute = String | Symbol | ^(untyped) [self: ::Alba::Resource::InstanceMethods] -> untyped | ConditionalAttribute | NestedAttribute | TypedAttribute | Association
    type instance_proc = ^(*untyped) [self: InstanceMethods] -> untyped

    INTERNAL_VARIABLES: Hash[Symbol, untyped]
    WITHIN_DEFAULT: Object
    EMPTY_HASH: generic_hash

    def self.included: (Class) -> void

    interface _InstanceMethods
      def nil?: () -> bool
      def object: () -> untyped
      def params: () -> generic_hash
      def serialize: (?root_key: root_key_type, ?meta: generic_hash) -> String
      def to_json: (?generic_hash, ?root_key: root_key_type, ?meta: generic_hash) -> String
      def as_json: (?generic_hash, ?root_key: root_key_type, ?meta: generic_hash) -> serializable_hash_type
      def serializable_hash: () -> serializable_hash_type
      alias to_h serializable_hash
    end

    interface _ClassMethods
      def method_added: (Symbol) -> void
      def inherited: (Class) -> void
      def attributes: (*(Symbol | String), ?if: instance_proc | Symbol | nil, **untyped) -> void
      def assign_attributes: (Array[Symbol | String], instance_proc | Symbol | nil) -> void
      def assign_attributes_with_types: (Hash[Symbol | String, untyped], instance_proc | Symbol | nil) ?{ (untyped) [self: InstanceMethods] -> untyped } -> void
      def attribute: (?Symbol | String | nil, ?if: instance_proc | Symbol | nil, **untyped) ?{ (untyped) [self: InstanceMethods] -> untyped } -> void
      def association: (Symbol | String, ?instance_proc?, ?resource: (Class | Proc | String | Symbol)?, ?serializer: (Class | Proc | String | Symbol)?, ?source: Proc?, ?key: key_type, ?with_traits: Symbol | Array[Symbol] | nil, ?params: generic_hash, **untyped) ?{ () [self: singleton(Resource)] -> void } -> (Alba::Association | Alba::ConditionalAttribute)
      alias one association
      alias many association
      alias has_one association
      alias has_many association
      def nesting: () -> String?
      def nested_attribute: (Symbol | String, **untyped) ?{ () [self: singleton(Resource)] -> void } -> (Alba::ConditionalAttribute | Alba::NestedAttribute)
      alias nested nested_attribute
      def trait: (Symbol | String) ?{ () [self: singleton(Resource)] -> void } -> Proc
      def root_key: (Symbol | String, ?Symbol | String | nil) -> Symbol?
      def root_key_for_collection: (Symbol | String) -> Symbol
      def root_key!: () -> class_key_type
      def meta: (?Symbol?) ?{ () [self: InstanceMethods] -> generic_hash } -> [Symbol?, Proc?]
      def layout: (?file: String?, ?inline: Proc?) -> Alba::Layout
      def transform_keys: (Symbol | String, ?root: bool, ?cascade: bool) -> bool
      def transform_keys!: (Symbol | String) -> untyped
      def collection_key: (Symbol | String) -> Symbol
      def on_error: (?( :raise | :ignore | :nullify | nil) handler) ?{ (*untyped) [self: InstanceMethods] -> untyped } -> (Proc | :raise | :ignore | :nullify)?
      def validated_error_handler: ((:raise | :ignore | :nullify | nil) handler) -> (:raise | :ignore | :nullify)?
      def on_nil: () ?{ (*untyped) [self: InstanceMethods] -> untyped } -> Proc?
      def helper: (?Module) ?{ (*untyped) [self: singleton(Resource)] -> untyped } -> Module
      def prefer_resource_method!: () -> Symbol
      def prefer_object_method!: () -> Symbol
    end

    module InstanceMethods
      @object: untyped
      @params: generic_hash
      @within: untyped
      @with_traits: Symbol | Array[Symbol] | nil

      def initialize: (untyped, ?params: generic_hash, ?within: within, ?with_traits: Symbol | Array[Symbol] | nil) -> void
      include _InstanceMethods

      def hash_from_traits: (untyped) -> generic_hash
      def serialize_with: (untyped) -> String
      def hash_with_metadata: (generic_hash, generic_hash) -> generic_hash
      def _metadata: (Proc?, generic_hash) -> generic_hash
      def serializable_hash_for_collection: () -> (Array[generic_hash] | Hash[root_key_type, generic_hash])
      def fetch_key: () -> root_key_type
      def _key_for_collection: () -> root_key_type
      def _key: () -> root_key_type
      def resource_name: (?pluralized: bool) -> String
      def transforming_root_key?: () -> bool
      def attributes_to_hash: (untyped, generic_hash) -> generic_hash
      def select: (key_type, untyped, attribute) -> bool
      def set_key_and_attribute_body_from: (untyped, untyped, attribute, generic_hash) -> void
      def do_select: (key_type, untyped, attribute) -> bool
      def handle_error: (StandardError, untyped, Symbol | String, attribute, generic_hash) -> void
      def transform_key: (Symbol | String | nil) -> untyped
      def fetch_attribute: (untyped, key_type, attribute) -> untyped
      def fetch_attribute_from_object_and_resource: (untyped, Symbol) -> untyped
      def _fetch_attribute_from_object_first: (untyped, Symbol) -> untyped
      def _fetch_attribute_from_resource_first: (untyped, Symbol) -> untyped
      def nil_handler: () -> Proc?
      def yield_if_within: (Symbol) { (within) -> untyped } -> untyped
      def check_within: (Symbol) -> within
      def _setup: () -> void

      # These methods are available on the eventual resource instance. Declaring
      # them here models the module's inclusion context for Steep.
      def class: () -> Class
      def instance_eval: [A] () { () [self: self] -> A } -> A
      def instance_exec: [A] (*untyped) { (*untyped) [self: self] -> A } -> A
      def __send__: (Symbol, *untyped) -> untyped
      def binding: () -> Binding
      def encode: (untyped) -> String
    end

    interface _ClassContext
      def alias_method: (Symbol, Symbol) -> Symbol
      def private: (*Symbol) -> void
      def instance_method: (Symbol) -> UnboundMethod
      def include: (*Module) -> self
      def extend: (*Module) -> self
      def class_eval: [A] () { () [self: untyped] -> A } -> A
      def module_eval: [A] () { () [self: untyped] -> A } -> A
      def name: () -> String
      def dup: () -> untyped
      def new: (*untyped, **untyped) -> Resource::_InstanceMethods
      def _resource_methods: () -> Array[Symbol]
    end

    module ClassMethods
      @_attributes: Hash[Symbol | String, attribute]
      @_key: class_key_type
      @_key_for_collection: class_key_type
      @_meta: [Symbol?, Proc?]?
      @_transform_type: transform_type
      @_transforming_root_key: bool
      @_key_transformation_cascade: bool
      @_on_error: (Proc | :raise | :ignore | :nullify)?
      @_on_nil: Proc?
      @_layout: Layout?
      @_collection_key: key_type
      @_helper: Module?
      @_resource_methods: Array[Symbol]
      @_select_arity: Integer?
      @_traits: Hash[Symbol, Proc]

      def alias_method: (Symbol, Symbol) -> Symbol
      def private: (*Symbol) -> void
      def instance_method: (Symbol) -> UnboundMethod
      def include: (*Module) -> self
      def extend: (*Module) -> self
      def class_eval: [A] () { () [self: untyped] -> A } -> A
      def module_eval: [A] () { () [self: untyped] -> A } -> A
      def name: () -> String
      def dup: () -> untyped
      def new: (*untyped, **untyped) -> Resource::_InstanceMethods
      def _resource_methods: () -> Array[Symbol]

      include _ClassMethods
    end

    include InstanceMethods
    extend ClassMethods
  end

  Serializer: singleton(Resource)
end
